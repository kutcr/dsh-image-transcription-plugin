@@ -0,0 +1,105 @@
+import type { Context } from '@deepseek-ai/cordis'
+import type { ConversationNodeDefinition } from '@deepseek-ai/dsh-client-runtime/client'
+import type { ImageTranscriptionStatusChatData } from '../contract/chat-nodes.ts'
+import { chatNode } from './common.ts'
+
+declare module '@deepseek-ai/dsh-client-ui-conversation/client' {
+  interface ChatNodeDataMap {
+    /** Pending or failed transcription of one submitted image message. */
+    'image-transcription-status': ImageTranscriptionStatusChatData
+  }
+}
+
+interface ImageTranscriptionAudit {
+  readonly transcriptionId: string
+  readonly target: { readonly kind?: string }
+  readonly failure?: { readonly message?: unknown; readonly code?: unknown }
+}
+
+interface ImageTranscriptionStatusState {
+  readonly transcriptionId: string
+  readonly seq: number
+  readonly time: number
+  readonly status: 'running' | 'succeeded' | 'failed'
+  readonly failure?: { readonly message: string; readonly code?: string }
+}
+
+type ImageTranscriptionEvent = Omit<Parameters<ConversationNodeDefinition['match']>[0], 'type' | 'data'> & {
+  readonly type: string
+  readonly data: ImageTranscriptionAudit
+}
+
+function transcriptionEvent(event: Parameters<ConversationNodeDefinition['match']>[0]): ImageTranscriptionEvent | undefined {
+  const candidate = event as unknown as ImageTranscriptionEvent
+  if (candidate.type !== 'image-transcription/request'
+    && candidate.type !== 'image-transcription/succeeded'
+    && candidate.type !== 'image-transcription/failed') return undefined
+  return candidate.data.target.kind === 'message' && candidate.data.transcriptionId !== '' ? candidate : undefined
+}
+
+function failureOf(audit: ImageTranscriptionAudit): ImageTranscriptionStatusState['failure'] {
+  const failure = audit.failure
+  if (typeof failure?.message !== 'string') return { message: 'Image transcription failed.' }
+  return {
+    message: failure.message,
+    ...typeof failure.code === 'string' ? { code: failure.code } : {},
+  }
+}
+
+/** Project each submitted image message's auxiliary transcription lifecycle into Chat. */
+export const imageTranscriptionDefinition: ConversationNodeDefinition<ImageTranscriptionStatusState> = {
+  kind: 'image-transcription-status',
+  target: 'chat',
+  match: (event) => {
+    const transcription = transcriptionEvent(event)
+    if (transcription === undefined) return null
+    return {
+      id: transcription.data.transcriptionId,
+      role: transcription.type === 'image-transcription/request' ? 'start' : 'update',
+    }
+  },
+  start: (_context, match) => {
+    const transcription = transcriptionEvent(match.event)
+    if (transcription === undefined || transcription.type !== 'image-transcription/request') {
+      throw new Error('image-transcription-status start requires an image transcription request')
+    }
+    return {
+      transcriptionId: transcription.data.transcriptionId,
+      seq: transcription.seq,
+      time: transcription.time,
+      status: 'running',
+    }
+  },
+  update: (context, match) => {
+    const transcription = transcriptionEvent(match.event)
+    if (transcription === undefined) return context.state
+    if (transcription.type === 'image-transcription/succeeded') return { ...context.state, status: 'succeeded' }
+    if (transcription.type === 'image-transcription/failed') {
+      const failure = failureOf(transcription.data)
+      return {
+        ...context.state,
+        status: 'failed',
+        ...failure === undefined ? {} : { failure },
+      }
+    }
+    return context.state
+  },
+  buildViewNode: (context) => {
+    if (context.state === undefined) return null
+    const state = context.state
+    const data: ImageTranscriptionStatusChatData = {
+      transcriptionId: state.transcriptionId,
+      time: state.time,
+      status: state.status === 'failed' ? 'failed' : 'running',
+      ...state.failure === undefined ? {} : { failure: state.failure },
+    }
+    return chatNode(context, 'image-transcription-status', state.seq, data, {
+      visibility: state.status === 'succeeded' ? 'hidden' : 'visible',
+    })
+  },
+}
+
+/** Register the image-transcription lifecycle projection. */
+export function registerImageTranscriptionConversationNode(ctx: Context): void {
+  ctx.conversationEvents.register(imageTranscriptionDefinition)
+}
