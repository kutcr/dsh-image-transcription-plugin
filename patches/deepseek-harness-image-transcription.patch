+import { describe, expect, it, vi } from 'vitest'
+import { AttachmentId } from '@deepseek-ai/dsh-attachment'
+import type { AttachmentStore, ImageAttachmentRef } from '@deepseek-ai/dsh-attachment'
+import { createUserMessage, ImageTranscriptionId } from '@deepseek-ai/dsh-llm'
+import { toPiContext } from '../src/context.ts'
+
+const ref: ImageAttachmentRef = { attachmentId: AttachmentId('a'), mediaType: 'image/png', bytes: 1, width: 1, height: 1 }
+const message = createUserMessage({
+  source: { kind: 'plugin', plugin: 'test' },
+  content: [{ type: 'image-transcription', transcriptionId: ImageTranscriptionId('tx'), attachments: [ref], text: 'red square', model: { provider: 'vision', model: 'v1' } }],
+})
+const options = { provider: 'p', model: 'm', messages: [message] }
+const attachments = { readImage: vi.fn(async () => ({ ref, data: Uint8Array.of(1) })) } as unknown as AttachmentStore
+
+describe('pi-ai image transcription mapping', () => {
+  it('uses stable text for a text target', () => {
+    expect(toPiContext(options)).toMatchObject({ messages: [{ content: expect.stringContaining('red square') }] })
+  })
+  it('restores original images for a visual target', async () => {
+    await expect(toPiContext(options, attachments, true)).resolves.toMatchObject({ messages: [{ content: [{ type: 'image', data: 'AQ==' }] }] })
+  })
+})
