+    .map(model => ({ value: `${group.id}\u0000${model.id}`, label: `${group.name} · ${model.name}` })))
+  const selectedProvider = selection.split('\u0000')[0]
+  const configurationRow = selectedProvider === ''
+    ? undefined
+    : state.rows.find(row => row.entry.provider === selectedProvider && row.configured)
+  const configurationTarget = configurationRow === undefined ? undefined : targetOf(configurationRow)
+  const configurationNamespace = configurationTarget === undefined
+    ? undefined
+    : state.namespaces.get(configurationTarget.settingsNs)
+  const save = async (): Promise<void> => {
+    setBusy(true); setFailure(undefined)
+    const [provider, model] = selection.split('\u0000')
+    const outputLimit = Number(maxOutputTokens)
+    const timeout = Number(timeoutMs)
+    try {
+      const response = await api.settings.mutate({
+        ns: 'image-transcription',
+        ops: selection === ''
+          ? [
+            { op: 'unset', path: ['provider'] },
+            { op: 'unset', path: ['model'] },
+            { op: 'set', path: ['maxOutputTokens'], value: outputLimit },
+            { op: 'set', path: ['timeoutMs'], value: timeout },
+          ]
+          : [
+            { op: 'set', path: ['provider'], value: provider },
+            { op: 'set', path: ['model'], value: model },
+            { op: 'set', path: ['maxOutputTokens'], value: outputLimit },
+            { op: 'set', path: ['timeoutMs'], value: timeout },
+          ],
+      })
+      if (!response.result.ok) throw new Error(response.result.error.message)
+      await controller.load()
+    } catch (error) { setFailure(messageOf(error)) } finally { setBusy(false) }
+  }
+  return (
+    <section className={styles['transcriptionCard']} aria-label={t('imageTranscriptionTitle')}>
+      <strong>{t('imageTranscriptionTitle')}</strong>
+      <p>{t('imageTranscriptionHelp')}</p>
+      <select className={`${styles['input']} ${styles['selectInput']}`} value={selection} disabled={!state.writable || busy} onChange={(event) => { setSelection(event.target.value) }}>
+        <option value="">{t('imageTranscriptionOff')}</option>
+        {choices.map(choice => <option key={choice.value} value={choice.value}>{choice.label}</option>)}
+      </select>
+      <details>
+        <summary>{t('modelAdvanced')}</summary>
+        <label>
+          <span>{t('imageTranscriptionMaxTokens')}</span>
+          <input className={styles['input']} type="number" min="1" step="1" value={maxOutputTokens} disabled={!state.writable || busy} onChange={(event) => { setMaxOutputTokens(event.target.value) }} />
+        </label>
+        <label>
+          <span>{t('imageTranscriptionTimeout')}</span>
+          <input className={styles['input']} type="number" min="1" step="1" value={timeoutMs} disabled={!state.writable || busy} onChange={(event) => { setTimeoutMs(event.target.value) }} />
+        </label>
+      </details>
+      {configurationTarget === undefined || configurationNamespace === undefined
+        ? null
+        : (
+          <details
+            className={styles['transcriptionConfig']}
+            open={configurationOpen}
+            onToggle={(event) => { setConfigurationOpen(event.currentTarget.open) }}
+          >
+            <summary className={styles['customizedSummary']}>{t('imageTranscriptionConfiguration')}</summary>
+            <ProviderEditor
+              key={configurationEpoch}
+              provider={configurationTarget.provider}
+              displayName={configurationTarget.displayName}
+              hideTitle
+              embedded
+              namespace={configurationNamespace}
+              settingsPath={configurationTarget.settingsPath}
+              {...configurationTarget.declared === true ? { declared: true } : {}}
+              api={api}
+              t={t}
+              readOnly={!state.writable}
+              onClose={(changed) => {
+                setConfigurationEpoch(current => current + 1)
+                setConfigurationOpen(false)
+                if (changed) void controller.load()
+              }}
+            />
+          </details>
+        )}
+      <div className={styles['rowActions']}>
+        <button type="button" className={styles['secondaryButton']} disabled={(selection === saved && maxOutputTokens === String(savedMaxOutputTokens) && timeoutMs === String(savedTimeoutMs)) || busy || !state.writable || !Number.isInteger(Number(maxOutputTokens)) || Number(maxOutputTokens) < 1 || !Number.isInteger(Number(timeoutMs)) || Number(timeoutMs) < 1} onClick={() => { void save() }}>{busy ? t('imageTranscriptionSaving') : t('imageTranscriptionSave')}</button>
+      </div>
+      {failure === undefined ? null : <p className={styles['error']}>{failure}</p>}
+    </section>
+  )
+}
